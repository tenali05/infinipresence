{
  "appId": "com.infinipresence.app",
  "appName": "infiniPresence",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "CapacitorHttp": { "enabled": false },
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#0f172a",
      "showSpinner": false
    },
    "StatusBar": { "style": "DARK", "backgroundColor": "#0f172a", "overlaysWebView": false }
  }
}
